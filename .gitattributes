# Normalize all text files to LF in the repository.
# This prevents CRLF/LF conflicts between Windows and macOS/Linux developers.
* text=auto eol=lf

# Binary files — never modify line endings
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.avif binary
*.svg binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
